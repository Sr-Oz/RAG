# Ollama connection (fully local — no API keys required)
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_OLLAMA_GENERATION_MODEL=qwen2.5:3b
RAG_OLLAMA_REQUEST_TIMEOUT=60
RAG_OLLAMA_MAX_RETRIES=3

# Chunking
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Vector store
RAG_CHROMA_PERSIST_DIR=./data/chroma
RAG_CHROMA_COLLECTION_NAME=rag_chunks

# Retrieval (dense + sparse fused via Reciprocal Rank Fusion)
RAG_RETRIEVAL_TOP_K=5
RAG_RRF_K=60

# Generation
RAG_GENERATION_TEMPERATURE=0.2
RAG_GENERATION_MAX_CONTEXT_CHUNKS=5

RAG_LOG_LEVEL=INFO
